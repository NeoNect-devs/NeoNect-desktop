#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/NeoNect/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @NEONECT_VERSION_MAJOR@,@NEONECT_VERSION_MINOR@,@NEONECT_VERSION_PATCH@,@NEONECT_BUILD_NUMBER@
PRODUCTVERSION  @NEONECT_VERSION_MAJOR@,@NEONECT_VERSION_MINOR@,@NEONECT_VERSION_PATCH@,@NEONECT_BUILD_NUMBER@
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NeoNect Devs\0"
            VALUE "FileDescription",  "NeoNect Decentralized E2EE Messenger\0"
            VALUE "FileVersion",      "@NEONECT_VERSION_FULL@\0"
            VALUE "InternalName",     "NeoNectApp\0"
            VALUE "LegalCopyright",   "Copyright (C) @NEONECT_BUILD_YEAR@ NeoNect Devs. All rights reserved.\0"
            VALUE "OriginalFilename", "NeoNectApp.exe\0"
            VALUE "ProductName",      "NeoNect\0"
            VALUE "ProductVersion",   "@NEONECT_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
